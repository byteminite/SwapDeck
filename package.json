{
  "name": "swapdeck",
  "productName": "SwapDeck",
  "version": "1.3.0",
  "description": "Steam account switcher",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev-profile",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "globaloffensive": "^3.3.0",
    "qrcode": "^1.5.4",
    "steam-session": "^1.9.4",
    "steam-user": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "htm": "^3.1.1"
  },
  "author": "byteminite",
  "license": "MIT",
  "build": {
    "appId": "app.swapdeck.switcher",
    "productName": "SwapDeck",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "SwapDeck-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SwapDeck",
      "artifactName": "SwapDeck-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "byteminite",
        "repo": "SwapDeck",
        "releaseType": "draft"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/byteminite/SwapDeck.git"
  }
}
